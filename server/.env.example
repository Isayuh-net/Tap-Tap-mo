# Copy this file to .env and change the values. Never commit .env.

PORT=3000
DB_PATH=data/tap-tap-mo.db
SCHOOL_TZ=Asia/Manila

# School day (24-hour times)
# Arriving after LATE_AFTER is late. Taps out between LUNCH_START and LUNCH_END are lunch (not texted);
# coming back after LUNCH_END is late from lunch (texted). Time out starts at DISMISSAL_TIME; leaving
# earlier (outside lunch) is an early out (texted).
LATE_AFTER=08:00
LUNCH_START=12:00
LUNCH_END=13:00
DISMISSAL_TIME=16:00
COOLDOWN_SECONDS=30

# Students without their card can type their 12-digit LRN at the gate (marked "LRN" on the dashboard).
ALLOW_LRN_ENTRY=true

# Each gate app sends its id and key. Format: id:key,id:key
GATE_KEYS=gate1:change-me-1,gate2:change-me-2

# Used to sign staff login cookies. Use a long random value.
SESSION_SECRET=change-me

# Daily database backups. BACKUP_DIR can be an external drive, e.g. E:/tap-tap-mo-backups
BACKUP_DIR=backups
BACKUP_TIME=18:00
BACKUP_KEEP=30

# SMS: "mock" prints texts to the console; "castph" sends real texts.
SMS_PROVIDER=mock
SMS_SENDER_NAME=BCNHS
SMS_RETRY_SECONDS=60
# Mock only: fraction of sends that fail on purpose (0 to 1), to test retries.
MOCK_SMS_FAIL_RATE=0

# Cast PH (fill in once you have their API details)
CASTPH_API_URL=
CASTPH_API_KEY=
