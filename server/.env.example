# Copy this file to .env and change the values. Never commit .env: it holds the passwords and keys below.
# Make each secret with this command (run it once per secret):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
DB_PATH=data/tap-tap-mo.db
# Student photos (uploaded on the Students page, shown at the gate). Copied with each backup.
PHOTOS_DIR=data/photos
# Excel files downloaded on Reports and files are also saved here, one folder per section.
# Can be changed on that page (for example to C:/Tap-Tap Mo/Reports).
REPORTS_DIR=data/reports
# School templates uploaded on Reports and files (SF2 form, student list).
TEMPLATES_DIR=data/templates
SCHOOL_TZ=Asia/Manila
SCHOOL_NAME=Baguio City National High School - Senior High School

# School day (24-hour times)
# Arriving after LATE_AFTER is late. Taps out between LUNCH_START and LUNCH_END are lunch (not texted);
# coming back after LUNCH_END is late from lunch (texted). Time out starts at DISMISSAL_TIME; leaving
# earlier (outside lunch) is an early out (texted).
LATE_AFTER=08:00
LUNCH_START=12:00
LUNCH_END=13:00
DISMISSAL_TIME=16:00
COOLDOWN_SECONDS=30

# Students without their card can type their 12-digit LRN at the gate (marked "LRN" on the dashboard).
ALLOW_LRN_ENTRY=true

# Each gate app sends its id and key (the same key goes in that gate PC's gate-app/config.json).
# Format: id:key,id:key. Use a random key for each gate, not these placeholders.
GATE_KEYS=gate1:change-me-1,gate2:change-me-2

# Signs staff login cookies. Use a random value (64 characters from the command above).
SESSION_SECRET=change-me

# Encrypts API keys typed on Lunch and SMS settings before they are saved in the database, so backups
# don't reveal them. 64 characters from the command above. Keep a copy of .env somewhere safe.
SECRETS_KEY=

# Daily database backups. BACKUP_DIR can be an external drive, e.g. E:/tap-tap-mo-backups
BACKUP_DIR=backups
BACKUP_TIME=18:00
BACKUP_KEEP=30

# SMS: "mock" prints texts to the console (test mode); "semaphore" sends real texts.
# Lunch and SMS settings on the dashboard can change these; those choices are used instead.
# SMS_SENDER_NAME starts every text, and must be a sender name approved on the Semaphore account.
SMS_PROVIDER=mock
SMS_SENDER_NAME=BCNHS
SMS_RETRY_SECONDS=60
# Mock only: fraction of sends that fail on purpose (0 to 1), to test retries.
MOCK_SMS_FAIL_RATE=0

# Semaphore (semaphore.co). The API key is on the account page. It can also be typed on Lunch and SMS
# settings (saved encrypted). Never put a real key in this example file.
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
SEMAPHORE_API_KEY=

# Cast PH (fill in once you have their API details)
CASTPH_API_URL=
CASTPH_API_KEY=
